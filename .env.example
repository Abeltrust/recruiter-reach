# AI Provider: 'api' (Google AI Studio Gemma 4) or 'local' (Ollama)
PROVIDER="api"

# Google AI Studio Gemini API Key (Required when PROVIDER=api)
# In AI Studio, this is injected automatically from Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Gemma 4 Model ID for Gemini API (Options: gemma-4-26b-a4b-it, gemma-4-31b-it)
GEMMA_MODEL="gemma-4-26b-a4b-it"

# Ollama settings (Used when PROVIDER=local)
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="gemma4:e2b"

# Server Port
PORT="3000"
